PORT=4000
NODE_ENV=development
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Local MySQL from database/docker-compose.yml
DATABASE_URL="mysql://pba:pba@localhost:3306/photosbyarelli"
# Photo storage (docs/almacenamiento-fotos.md). Default: Backend/storage. In production: the fixed-size photo file system.
# STORAGE_PATH=/app/storage
# STORAGE_RESERVE_BYTES=524288000
# SUPPORT_EMAIL=soporte@nimbuscloud.mx
# Key for the download PIN and gallery passwords (AES-256-GCM). Any long random string; never change it afterwards.
# Without it, development derives one from JWT_SECRET — set it in production.
# GALLERY_ENC_KEY=
# Emails (docs/correos.md). Key that encrypts the SMTP/IMAP passwords inside settings.json. Any long
# random string; never change it afterwards (Areli would have to type the passwords again).
# Without it, the API falls back to GALLERY_ENC_KEY — set it in production.
# CONFIG_SECRET_KEY=
# Where settings.json lives. Default: Backend/var/settings.json. In production compose sets /data/config/settings.json.
# CONFIG_PATH=
# Base of the links inside emails (login, client portal, logo). Default: CLIENT_ORIGIN.
# APP_URL=http://localhost:4321
# Development sends everything to Mailpit (database/docker-compose.yml, UI on :8025).
# MAILPIT_HOST=localhost
# MAILPIT_PORT=1025
# MAILPIT_UI=http://localhost:8025
# Development only: use the real SMTP from settings.json, but only to these addresses.
# EMAIL_DEV_REAL_SMTP=true
# EMAIL_DEV_ALLOWLIST=you@example.com
# Deletes the photos of expired galleries automatically (D9). Keep off until the 48-hour warning email exists.
# GALLERY_AUTO_DELETE=1
# Website visits on the Overview (Cloudflare Web Analytics — docs/overview-integraciones.md). Without them the widget shows "Not connected".
# CF_ACCOUNT_ID=
# CF_SITE_TAG=
# API token with the "Account Analytics: Read" permission.
# CF_API_TOKEN=

# Contact e-mail written into the photos' copyright metadata (Backend/services/photo-rights.js).
# OWNER_EMAIL=hello@example.com
