---
// List of services with their starting price (home "Services", service pages "Other sessions").
// variant "grid": 3 columns with hairlines on desktop (Main.dc.html); "list": one row each.
import { SERVICES } from "../../data/site";
import { localizePath, useT, type Lang } from "../../i18n";
import { money } from "../../utils/money";

interface Props {
  lang: Lang;
  variant?: "grid" | "list";
  exclude?: string;
}
const { lang, variant = "list", exclude } = Astro.props;
const { t } = useT(lang);
const items = SERVICES.filter((s) => s.slug !== exclude);
const price = (from: number) => `<em>${t("common.from")}</em> ${money(from)} →`;
---

{
  variant === "grid" ? (
    <>
      <ul class="m-0 hidden list-none grid-cols-3 border-y border-line p-0 lg:grid">
        {items.map((s, k) => (
          <li class:list={[k % 3 !== 0 && "border-l border-line", k >= 3 && "border-t border-line"]}>
            <a href={localizePath(`/services/${s.slug}/`, lang)} class:list={["flex flex-col gap-1.5 py-6 text-ink", k % 3 === 0 ? "pr-6" : "px-6"]}>
              <span class="text-2xl leading-tight">{t(`services.${s.slug}.name`)}</span>
              <span class="text-[15px] text-muted" set:html={price(s.from)} />
            </a>
          </li>
        ))}
      </ul>
      <ul class="m-0 list-none border-b border-line p-0 lg:hidden">
        {items.map((s) => (
          <li>
            <a href={localizePath(`/services/${s.slug}/`, lang)} class="flex items-baseline justify-between gap-3 border-t border-line py-[18px] text-ink">
              <span class="text-[21px] leading-tight">{t(`services.${s.slug}.name`)}</span>
              <span class="text-[15px] whitespace-nowrap text-muted" set:html={price(s.from)} />
            </a>
          </li>
        ))}
      </ul>
    </>
  ) : (
    <ul class="m-0 list-none border-b border-line p-0">
      {items.map((s) => (
        <li>
          <a href={localizePath(`/services/${s.slug}/`, lang)} class="flex items-baseline justify-between gap-3 border-t border-line py-[18px] text-ink">
            <span class="text-[21px] lg:text-[22px]">{t(`services.${s.slug}.name`)}</span>
            <span class="whitespace-nowrap text-muted" set:html={price(s.from)} />
          </a>
        </li>
      ))}
    </ul>
  )
}
