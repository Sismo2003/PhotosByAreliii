---
// Home hero (Main.dc.html: text left, two portraits right; LandingMobile: one full-width photo first).
import Photo from "../site/Photo.astro";
import { BRAND, SHARED_VARS } from "../../data/site";
import { HERO } from "../../data/photos";
import { localizePath, useT, type Lang } from "../../i18n";

const { lang } = Astro.props as { lang: Lang };
const { t } = useT(lang, SHARED_VARS);
---

<section class="container-site lg:page-x grid gap-8 lg:h-[620px] lg:grid-cols-[minmax(0,1fr)_minmax(0,700px)] lg:gap-16 lg:pt-6">
  <div class="page-x order-2 flex flex-col justify-end lg:order-1 lg:max-w-[420px] lg:px-0 lg:pb-2">
    <h1 class="eyebrow m-0 text-muted"><span class="sr-only">{BRAND.name} — </span>{t("home.eyebrow")}</h1>
    <p class="mt-3.5 mb-7 text-[20px] leading-[30px] lg:mt-[18px] lg:mb-8 lg:text-[21px] lg:leading-8" set:html={t("home.lead")} />
    <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8">
      <a href={localizePath("/book/", lang)} class="btn btn-primary w-full sm:w-auto">{t("common.bookSession")}</a>
      <a href={localizePath("/services/", lang)} class="link-line">{t("common.seeServices")}</a>
    </div>
  </div>
  <div class="order-1 grid items-start gap-4 lg:order-2 lg:grid-cols-2">
    <Photo photo={HERO[0]} lang={lang} priority sizes="(min-width: 1024px) 342px, 100vw" widths={[390, 640, 780, 1000, 1280]} class="h-[470px] w-full lg:h-[500px]" />
    <Photo photo={HERO[1]} lang={lang} sizes="342px" widths={[400, 700]} class="hidden h-[500px] w-full lg:mt-24 lg:block" />
  </div>
</section>
