---
// Home portfolio (Main.dc.html #portfolio): staggered columns (4 desktop, 2 phone) with a filter per
// service. Without JS every photo shows; with JS the filter hides the others.
import Photo from "../site/Photo.astro";
import { SERVICES } from "../../data/site";
import { PORTFOLIO } from "../../data/photos";
import { localizePath, useT, type Lang } from "../../i18n";

const { lang } = Astro.props as { lang: Lang };
const { t } = useT(lang);
// Heights give the grid its rhythm (the design varies them per column).
const HEIGHTS = ["h-[230px] lg:h-[360px]", "h-[200px] lg:h-[300px]", "h-[190px] lg:h-[280px]", "h-[220px] lg:h-[340px]", "h-[240px] lg:h-[380px]"];
const used = new Set(PORTFOLIO.map((p) => p.photo.service));
const filters = SERVICES.filter((s) => used.has(s.slug));
---

<section id="portfolio" data-portfolio class="page-x container-site scroll-mt-4 pt-[72px] lg:pt-[120px]">
  <div class="mb-6 flex flex-col gap-4 lg:mb-10 lg:flex-row lg:items-baseline lg:justify-between">
    <div>
      <h2 class="eyebrow m-0">{t("home.portfolioTitle")}</h2>
      <p class="mt-1.5 mb-0 text-[19px] leading-7 lg:mt-2 lg:text-[21px] lg:leading-8" set:html={t("home.portfolioLead")} />
    </div>
    <div role="group" aria-label={t("home.filters")} class="eyebrow -mx-4 flex gap-6 overflow-x-auto px-4 [scrollbar-width:none] lg:mx-0 lg:gap-7 lg:px-0">
      <button type="button" data-filter="" aria-pressed="true" class="shrink-0 cursor-pointer border-0 border-b border-ink bg-transparent px-0 pt-0 pb-[3px] text-ink">{t("home.filterAll")}</button>
      {
        filters.map((s) => (
          <button type="button" data-filter={s.slug} aria-pressed="false" class="shrink-0 cursor-pointer border-0 border-b border-transparent bg-transparent px-0 pt-0 pb-[3px] whitespace-nowrap text-muted">
            {t(`services.${s.slug}.name`)}
          </button>
        ))
      }
    </div>
  </div>

  <div class="columns-2 gap-3 lg:columns-4 lg:gap-4">
    {
      PORTFOLIO.map((item, k) => (
        <figure data-service={item.photo.service} class="m-0 mb-3 flex break-inside-avoid flex-col gap-2 lg:mb-4">
          <a href={localizePath(`/services/${item.photo.service}/`, lang)} class="block">
            <Photo photo={item.photo} lang={lang} sizes="(min-width: 1024px) 300px, 50vw" widths={[300, 450, 600, 900]} class:list={["w-full", HEIGHTS[k % HEIGHTS.length], item.frame && "print-frame box-border"]} />
          </a>
          {item.caption && <figcaption class="text-sm leading-5 text-muted italic">{t(`services.${item.photo.service}.name`)}</figcaption>}
        </figure>
      ))
    }
  </div>

  <div class="mt-7 flex justify-center lg:mt-10">
    <a href={localizePath("/services/", lang)} class="btn btn-outline w-full sm:w-auto">{t("common.viewFullPortfolio")}</a>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-portfolio]")) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const items = [...root.querySelectorAll<HTMLElement>("[data-service]")];
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        const f = b.dataset.filter;
        buttons.forEach((x) => {
          const on = x === b;
          x.setAttribute("aria-pressed", String(on));
          x.classList.toggle("border-ink", on);
          x.classList.toggle("text-ink", on);
          x.classList.toggle("border-transparent", !on);
          x.classList.toggle("text-muted", !on);
        });
        items.forEach((it) => (it.hidden = !!f && it.dataset.service !== f));
      }),
    );
  }
</script>
